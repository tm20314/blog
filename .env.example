# Google Analytics 4: Web data stream measurement ID (example: G-XXXXXXXXXX)
PUBLIC_GA_MEASUREMENT_ID=

# Google AdSense: Client ID from the site code (example: ca-pub-1234567890123456)
PUBLIC_ADSENSE_CLIENT_ID=

# microCMS server-side credentials. Never prefix the API key with PUBLIC_.
MICROCMS_SERVICE_DOMAIN=
MICROCMS_API_KEY=
MICROCMS_API_ENDPOINT=blogs
