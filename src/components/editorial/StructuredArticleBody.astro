---
import { getSafeEmbed } from "@utils/embed-utils";
import sanitizeHtml from "sanitize-html";
import type { EditorialBlock } from "@/types/editorial-blocks";

interface Props {
	blocks: EditorialBlock[];
}

const { blocks } = Astro.props;
const allowedTags = [
	...sanitizeHtml.defaults.allowedTags,
	"figure",
	"figcaption",
	"img",
	"h2",
	"h3",
	"h4",
];
const cleanHtml = (html: string) =>
	sanitizeHtml(html, {
		allowedTags,
		allowedAttributes: {
			"*": ["class"],
			a: ["href", "target", "rel", "class"],
			img: ["src", "alt", "width", "height", "loading", "decoding"],
		},
		allowedSchemes: ["http", "https", "mailto"],
		transformTags: {
			a: (_tagName, attribs) => ({
				tagName: "a",
				attribs: {
					...attribs,
					rel:
						attribs.target === "_blank" ? "noopener noreferrer" : attribs.rel,
				},
			}),
		},
	});
const textOnly = (html: string) =>
	sanitizeHtml(html, { allowedTags: [], allowedAttributes: {} }).trim();
const safeUrl = (value: string) =>
	/^(?:https?:\/\/|mailto:|\/|#)/u.test(value.trim()) ? value.trim() : "#";
const safeMediaUrl = (value: string) =>
	/^(?:https?:\/\/|\/)/u.test(value.trim()) ? value.trim() : "";
const getHostname = (value: string) => {
	try {
		return new URL(value).hostname.replace(/^www\./u, "");
	} catch {
		return "リンク先";
	}
};
const faqItems = blocks.filter(
	(block): block is Extract<EditorialBlock, { fieldId: "faq" }> =>
		block.fieldId === "faq",
);
const faqSchema = faqItems.length
	? {
			"@context": "https://schema.org",
			"@type": "FAQPage",
			mainEntity: faqItems.map((item) => ({
				"@type": "Question",
				name: item.question,
				acceptedAnswer: {
					"@type": "Answer",
					text: textOnly(item.answer),
				},
			})),
		}
	: null;
---

{faqSchema && (
	<script is:inline type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
)}

<div class="custom-md editorial-prose structured-article" data-pagefind-body>
	{blocks.map((block, blockIndex) => (
		<>
			{block.fieldId === "richText" && (
				<div class="structured-article__rich-text" set:html={cleanHtml(block.body)} />
			)}

			{block.fieldId === "box" && (
				<aside class:list={["editor-block", "editor-box", `editor-box--${block.tone}`]}>
					{block.title && <p class="editor-box__title">{block.title}</p>}
					<div class="editor-box__body" set:html={cleanHtml(block.body)} />
				</aside>
			)}

			{block.fieldId === "button" && (
				<a
					class:list={["editor-block", "editor-button", `editor-button--${block.variant ?? "primary"}`, "no-styling"]}
					href={safeUrl(block.url)}
				>
					<span>{block.label}</span><span class="editor-button__icon" aria-hidden="true">↗</span>
				</a>
			)}

			{block.fieldId === "speech" && (
				<aside class:list={["editor-block", "editor-speech", `editor-speech--${block.side ?? "left"}`]} aria-label={`${block.name ?? "つもつも"}のコメント`}>
					<div class="editor-speech__person">
						<span class="editor-speech__avatar" aria-hidden="true">
						{block.avatar && safeMediaUrl(block.avatar.url)
							? <img src={safeMediaUrl(block.avatar.url)} alt="" loading="lazy" decoding="async" />
								: <span class="editor-speech__symbol">つ</span>}
						</span>
						<span class="editor-speech__name">{block.name ?? "つもつも"}</span>
					</div>
					<div class="editor-speech__body" set:html={cleanHtml(block.body)} />
				</aside>
			)}

			{block.fieldId === "faq" && (
				<section class="editor-block editor-faq">
					<h3 class="editor-faq__question">
						<span class="editor-faq__mark">Q</span><span class="editor-faq__title">{block.question}</span>
					</h3>
					<div class="editor-faq__answer">
						<span class="editor-faq__mark">A</span><div class="editor-faq__body" set:html={cleanHtml(block.answer)} />
					</div>
				</section>
			)}

			{block.fieldId === "accordion" && (
				<details class="editor-block editor-accordion">
					<summary class="editor-accordion__summary">{block.title}</summary>
					<div class="editor-accordion__body" set:html={cleanHtml(block.body)} />
				</details>
			)}

			{block.fieldId === "stepList" && (
				<section class="editor-block editor-step-list">
					{block.title && <h3 class="editor-step-list__title">{block.title}</h3>}
					<ol class="editor-steps">
						{block.items.map((item) => (
							<li class="editor-step">
								<p class="editor-step__title">{item.title}</p>
								<div class="editor-step__body" set:html={cleanHtml(item.body)} />
							</li>
						))}
					</ol>
				</section>
			)}

			{block.fieldId === "prosCons" && (
				<section class="editor-block editor-pros-cons">
					<h3 class="editor-pros-cons__title">{block.title ?? "良かった点・気になった点"}</h3>
					<div class="editor-pros-cons__grid">
						<section class="editor-pros-cons__section editor-pros">
							<h4 class="editor-pros-cons__heading">良かった点</h4>
							<ul>{block.pros.map((item) => <li>{item}</li>)}</ul>
						</section>
						<section class="editor-pros-cons__section editor-cons">
							<h4 class="editor-pros-cons__heading">気になった点</h4>
							<ul>{block.cons.map((item) => <li>{item}</li>)}</ul>
						</section>
					</div>
				</section>
			)}

			{block.fieldId === "comparison" && (
				<figure class="editor-block editor-comparison">
					<figcaption class="editor-comparison__caption">{block.caption ?? "比較表"}</figcaption>
					<div class="editor-comparison__scroll" tabindex="0">
						<table>
							<thead><tr>{block.headers.map((header) => <th scope="col">{header}</th>)}</tr></thead>
							<tbody>{block.rows.map((row) => <tr>{row.map((cell, index) => index === 0 ? <th scope="row">{cell}</th> : <td>{cell}</td>)}</tr>)}</tbody>
						</table>
					</div>
				</figure>
			)}

			{block.fieldId === "product" && (
				<aside class="editor-block editor-product">
					{block.image && safeMediaUrl(block.image.url) && (
						<figure class="editor-product__media">
							<img src={safeMediaUrl(block.image.url)} alt={block.image.alt ?? ""} loading="lazy" decoding="async" />
						</figure>
					)}
					<div class="editor-product__body">
						<p class="editor-product__eyebrow">紹介した製品</p>
						<h3 class="editor-product__title">{block.name}</h3>
						{block.summary && <p class="editor-product__summary">{block.summary}</p>}
						<div class="editor-product__actions">
							{block.links.map((link) => (
								<a class="no-styling" href={safeUrl(link.url)} rel={link.type === "affiliate" ? "sponsored noopener" : "noopener"}>
									{link.label}<span class="editor-product__action-icon" aria-hidden="true">↗</span>
								</a>
							))}
						</div>
						<small class="editor-product__disclosure">{block.disclosure ?? "リンクにはアフィリエイトを含む場合があります。"}</small>
					</div>
				</aside>
			)}

			{block.fieldId === "linkCard" && safeUrl(block.url) !== "#" && (
				<aside class="editor-block smart-link-card">
					<a class="no-styling smart-link-card__link" href={safeUrl(block.url)} target="_blank" rel="noopener noreferrer">
						{block.image && safeMediaUrl(block.image.url) ? (
							<span class="smart-link-card__thumbnail" aria-hidden="true">
								<img src={safeMediaUrl(block.image.url)} alt="" loading="lazy" decoding="async" />
							</span>
						) : (
							<span class="smart-link-card__mark" aria-hidden="true">{getHostname(block.url).charAt(0)}</span>
						)}
						<span class="smart-link-card__body">
							<span class="smart-link-card__eyebrow">BLOG CARD</span>
							<strong class="smart-link-card__title">{block.title || getHostname(block.url)}</strong>
							<span class="smart-link-card__meta">{block.description || getHostname(block.url)}</span>
						</span>
						<span class="smart-link-card__action">開く ↗</span>
					</a>
				</aside>
			)}

			{block.fieldId === "embed" && getSafeEmbed(block.url) && (
				<figure class:list={["editor-block", "media-embed", `media-embed--${getSafeEmbed(block.url)?.kind}`, `media-embed--${getSafeEmbed(block.url)?.provider}`, getSafeEmbed(block.url)?.provider === "tiktok" && "media-embed--portrait"]}>
					<div class="media-embed__header">
						<strong class="media-embed__provider">{getSafeEmbed(block.url)?.label}</strong>
						<a class="media-embed__source" href={safeUrl(block.url)} target="_blank" rel="noopener noreferrer">元の投稿を開く ↗</a>
					</div>
					<div class="media-embed__viewport">
						<iframe
							class="media-embed__frame"
							src={getSafeEmbed(block.url)?.src}
							title={getSafeEmbed(block.url)?.title}
							loading="lazy"
							allow={getSafeEmbed(block.url)?.allow}
							allowfullscreen={getSafeEmbed(block.url)?.allowFullScreen}
							referrerpolicy="strict-origin-when-cross-origin"
						></iframe>
					</div>
					{block.caption && <figcaption>{block.caption}</figcaption>}
				</figure>
			)}

			{block.fieldId === "imagePanel" && block.image && safeMediaUrl(block.image.url) && (
				<figure class:list={["editor-block", "editor-image-panel", `editor-image-panel--${block.style}`]}>
					{block.style === "browser" && (
						<div class="editor-image-panel__chrome" aria-hidden="true"><span></span><span></span><span></span></div>
					)}
					<img src={safeMediaUrl(block.image.url)} alt={block.alt ?? ""} loading="lazy" decoding="async" />
					{block.caption && <figcaption>{block.caption}</figcaption>}
				</figure>
			)}

			{block.fieldId === "columns" && (
				<div class="editor-block editor-columns">
					<section class="editor-columns__column">
						{block.leftTitle && <h3>{block.leftTitle}</h3>}
						<div set:html={cleanHtml(block.leftBody)} />
					</section>
					<section class="editor-columns__column">
						{block.rightTitle && <h3>{block.rightTitle}</h3>}
						<div set:html={cleanHtml(block.rightBody)} />
					</section>
				</div>
			)}

			{block.fieldId === "tabs" && block.tabs.length > 0 && (
				<section class="editor-block editor-tabs" data-editor-tabs>
					<div class="editor-tabs__list" role="tablist" aria-label="記事内タブ">
						{block.tabs.map((tab, tabIndex) => (
							<button
								type="button"
								id={`editor-tab-${blockIndex}-${tabIndex}`}
								role="tab"
								aria-selected={tabIndex === 0 ? "true" : "false"}
								aria-controls={`editor-panel-${blockIndex}-${tabIndex}`}
								tabindex={tabIndex === 0 ? 0 : -1}
							>{tab.label}</button>
						))}
					</div>
					{block.tabs.map((tab, tabIndex) => (
						<div
							class="editor-tabs__panel"
							id={`editor-panel-${blockIndex}-${tabIndex}`}
							role="tabpanel"
							aria-labelledby={`editor-tab-${blockIndex}-${tabIndex}`}
							hidden={tabIndex !== 0}
							set:html={cleanHtml(tab.body)}
						/>
					))}
				</section>
			)}
		</>
	))}
</div>

<script>
	const activateTab = (button: HTMLButtonElement) => {
		const tabs = button.closest<HTMLElement>("[data-editor-tabs]");
		if (!tabs) return;
		for (const candidate of tabs.querySelectorAll<HTMLButtonElement>("[role='tab']")) {
			const active = candidate === button;
			candidate.setAttribute("aria-selected", String(active));
			candidate.tabIndex = active ? 0 : -1;
			const panel = tabs.querySelector<HTMLElement>(`#${candidate.getAttribute("aria-controls")}`);
			if (panel) panel.hidden = !active;
		}
	};

	document.addEventListener("click", (event) => {
		const button = (event.target as Element | null)?.closest<HTMLButtonElement>("[data-editor-tabs] [role='tab']");
		if (button) activateTab(button);
	});

	document.addEventListener("keydown", (event) => {
		const button = (event.target as Element | null)?.closest<HTMLButtonElement>("[data-editor-tabs] [role='tab']");
		if (!button || !["ArrowLeft", "ArrowRight", "Home", "End"].includes(event.key)) return;
		const buttons = [...(button.closest("[data-editor-tabs]")?.querySelectorAll<HTMLButtonElement>("[role='tab']") ?? [])];
		if (!buttons.length) return;
		event.preventDefault();
		const index = buttons.indexOf(button);
		const next = event.key === "Home" ? buttons[0] : event.key === "End" ? buttons.at(-1) : buttons[(index + (event.key === "ArrowRight" ? 1 : -1) + buttons.length) % buttons.length];
		if (next) {
			activateTab(next);
			next.focus();
		}
	});
</script>
