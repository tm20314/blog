---
import path from "node:path";
import ImageWrapper from "@components/misc/ImageWrapper.astro";
import { publication } from "@/config/site";
import type { ArticleEntry, PostForList } from "@utils/content-utils";
import { formatDateToYYYYMMDD } from "@utils/date-utils";
import { getCategoryUrl, getDir, getPostUrlBySlug } from "@utils/url-utils";

interface Props {
	post: ArticleEntry | PostForList;
	variant?: "standard" | "lead";
}

const { post, variant = "standard" } = Astro.props;
const category = post.data.category || "雑記";
const postUrl = getPostUrlBySlug(post.slug);
const coverImage = post.data.image?.trim() || publication.defaultImage;
---

<article class:list={["article-card", `article-card--${variant}`]}>
	<ImageWrapper
		src={coverImage}
		basePath={post.source === "local" ? path.join("content/posts/", getDir(post.id)) : "/"}
		class="article-card__media"
		alt=""
		sizes={variant === "lead" ? "(min-width: 60rem) 60vw, 100vw" : "(min-width: 60rem) 30vw, (min-width: 40rem) 50vw, 100vw"}
	/>
	<div class="article-card__meta">
		<a href={getCategoryUrl(category)}>{category}</a>
		<time datetime={formatDateToYYYYMMDD(post.data.published)}>
			{formatDateToYYYYMMDD(post.data.published).replaceAll("-", ".")}
		</time>
	</div>
	<h3><a href={postUrl}>{post.data.title}</a></h3>
	{post.data.description && <p>{post.data.description}</p>}
	<span class="article-card__read" aria-hidden="true">
		記事を読む <span aria-hidden="true">↗</span>
	</span>
</article>
