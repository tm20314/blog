---
import type { ArticleEntry } from "@utils/content-utils";
import { url } from "@utils/url-utils";
import ArticleCard from "./ArticleCard.astro";

interface Props {
	posts: ArticleEntry[];
}

const { posts } = Astro.props;
---

{posts.length > 0 && (
	<section class="article-related" aria-labelledby="related-heading">
		<header class="article-related__heading">
			<div>
				<h2 id="related-heading">あわせて読みたい</h2>
				<p>テーマの近い記事を選びました。</p>
			</div>
			<a href={url("/archive/")}>記事一覧へ <span aria-hidden="true">→</span></a>
		</header>
		<div class="article-related__grid">
			{posts.map((post) => <ArticleCard post={post} />)}
		</div>
	</section>
)}
