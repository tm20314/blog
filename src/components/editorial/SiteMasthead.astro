---
import { url } from "@utils/url-utils";
import { publication } from "@/config/site";

const active = (href: string) =>
	!href.includes("#") &&
	(Astro.url.pathname === href ||
		(href === "/archive/" && Astro.url.pathname.startsWith("/category/")));
---

<header class="masthead">
	<a class="skip-link" href="#main-content">本文へ移動</a>
	<div class="masthead__bar">
		<a class="wordmark" href={url("/")} aria-label={`${publication.name} ホーム`}>
			<span class="wordmark__symbol" aria-hidden="true">{publication.symbol}</span>
			<span class="wordmark__text">
				<strong>{publication.name}</strong>
				<small>{publication.tagline}</small>
			</span>
		</a>
		<nav class="masthead__navigation" aria-label="メインナビゲーション">
			{publication.navigation.map((link) => <a href={url(link.href)} aria-current={active(link.href) ? "page" : undefined}>{link.label}</a>)}
		</nav>
		<details class="masthead__menu">
			<summary>メニュー</summary>
			<nav aria-label="モバイルナビゲーション">
				{publication.navigation.map((link) => <a href={url(link.href)} aria-current={active(link.href) ? "page" : undefined}>{link.label}</a>)}
			</nav>
		</details>
		<a class="masthead__cta" href={url("/#journal")}>
			ブログを読む <span aria-hidden="true">↘</span>
		</a>
	</div>
</header>
