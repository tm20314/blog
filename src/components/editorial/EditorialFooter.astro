---
import { url } from "@utils/url-utils";
import { profileConfig } from "@/config";
import { publication } from "@/config/site";

const amazonAssociateTag =
	import.meta.env.PUBLIC_AMAZON_ASSOCIATE_TAG?.trim() ?? "";
const hasAmazonAssociateTag = /^[A-Za-z0-9_-]+-\d{2}$/.test(amazonAssociateTag);
---

<footer class="editorial-footer">
	<p class="editorial-footer__statement">使って、作って、<br />ちゃんと残す。</p>
	<div class="editorial-footer__meta">
		<a class="editorial-footer__wordmark" href={url("/")}>{publication.name}</a>
		<nav class="editorial-footer__links" aria-label="フッターナビゲーション">
			{publication.navigation.map((link) => <a href={url(link.href)}>{link.label}</a>)}
			<a href={url("/privacy/")}>プライバシー</a>
			<a href={url("/rss.xml")}>RSS</a>
			{profileConfig.links.map((link) => (
				<a href={link.url} rel="me noopener" target="_blank">{link.name}</a>
			))}
		</nav>
		{hasAmazonAssociateTag && (
			<p class="editorial-footer__disclosure">
				Amazonのアソシエイトとして、{publication.name}は適格販売により収入を得ています。
			</p>
		)}
		<p class="editorial-footer__legal">© {new Date().getFullYear()} {publication.author} · Built independently in Japan.</p>
	</div>
</footer>
