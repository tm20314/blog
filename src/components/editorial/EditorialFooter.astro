---
import { profileConfig } from "@/config";
import { url } from "@utils/url-utils";
---

<footer class="editorial-footer">
	<div class="editorial-footer__top">
		<p class="editorial-footer__name">つもログ</p>
		<p class="editorial-footer__statement">
			ガジェットを試し、アプリを作り、途中で分かったことまで残す個人メディア。
		</p>
	</div>
	<div class="editorial-footer__links">
		<nav aria-label="フッターナビゲーション">
			<a href={url("/")}>Home</a>
			<a href={url("/archive/")}>Archive</a>
			<a href={url("/about/")}>About</a>
			<a href={url("/rss.xml")}>RSS</a>
		</nav>
		<nav aria-label="ソーシャルリンク">
			{profileConfig.links.map((link) => (
				<a href={link.url} rel="me noopener" target="_blank">{link.name}</a>
			))}
		</nav>
	</div>
	<div class="editorial-footer__legal">
		<span>© {new Date().getFullYear()} TumoTumo</span>
		<span>Built independently in Japan.</span>
	</div>
</footer>
