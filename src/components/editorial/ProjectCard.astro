---
import { Image } from "astro:assets";
import type { Project } from "@/data/projects";
import { url } from "@utils/url-utils";

interface Props { project: Project; index: number; total: number; }
const { project, index, total } = Astro.props;
---

<article class="project">
	<figure class:list={["project__visual", `project__visual--${project.visualTone}`]}>
		<Image class="project__screen" src={project.screen} alt={project.screenAlt}
			widths={[360, 520, 720]} sizes="(min-width: 60rem) 34vw, 100vw" format="avif" loading="lazy" />
		<figcaption>
			<Image class="project__icon" src={project.icon} alt={project.iconAlt} width={64} height={64} format="webp" loading="lazy" />
			<span>{String(index + 1).padStart(2, "0")} / {String(total).padStart(2, "0")}</span>
		</figcaption>
	</figure>
	<div class="project__body">
		<div class="project__meta"><span>{project.kicker}</span><span class="project__status">{project.proof}</span></div>
		<h3>{project.name}</h3>
		<p class="project__tagline">{project.tagline}</p>
		<p class="project__description">{project.description}</p>
		<ul class="project__stack" aria-label="使用技術・領域">
			{project.stack.map((item) => <li>{item}</li>)}
		</ul>
		<div class="project__actions" aria-label={`${project.name}の入手先`}>
			{project.links.map((link) => (
				<a class="project__store" href={link.href} target="_blank" rel="noopener noreferrer" aria-label={`${project.name}を${link.label}で見る（新しいタブ）`}>
					<span>{link.label}</span><span aria-hidden="true">↗</span>
				</a>
			))}
		</div>
		{project.story && <a class="project__link" href={url(project.story.href)}>{project.story.label} <span aria-hidden="true">→</span></a>}
	</div>
</article>
