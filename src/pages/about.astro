---
import { Image } from "astro:assets";
import { getEntry, render } from "astro:content";
import avatarImage from "@assets/images/tumotumo-profile.jpg";
import Markdown from "@components/misc/Markdown.astro";
import EditorialLayout from "@layouts/EditorialLayout.astro";
import { url } from "@utils/url-utils";
import { profileConfig } from "@/config";

const aboutPost = await getEntry("spec", "about");

if (!aboutPost) {
	throw new Error("About page content not found");
}

const { Content } = await render(aboutPost);
---

<EditorialLayout
	title="プロフィール"
	description="つもログを書き、モバイルアプリを個人開発しているTumoTumoのプロフィールです。"
>
	<main id="main-content" class="content-page about-page">
		<header class="page-intro page-intro--about">
			<div class="page-intro__title">
				<p class="page-intro__index">About / Developer & Writer</p>
				<h1>TumoTumoの<br />プロフィール</h1>
			</div>
			<p>つもログを書いているTumoTumoです。ガジェットの話と、自分で作ったアプリを紹介しています。</p>
		</header>

		<section class="profile-sheet" aria-labelledby="profile-heading">
			<div class="profile-sheet__portrait">
				<Image
					src={avatarImage}
					alt="屋外で微笑むTumoTumoのポートレート"
					widths={[360, 600, 900]}
					sizes="(min-width: 48rem) 44vw, 100vw"
					format="avif"
					loading="eager"
				/>
			</div>
			<div class="profile-sheet__body">
				<p class="profile-sheet__role">Independent developer / Japan</p>
				<h2 id="profile-heading">{profileConfig.name}</h2>
				<p class="profile-sheet__lead">PCやスマホ、バイクが好きなエンジニアです。岡理アプリなどのモバイルアプリを個人で開発しています。</p>
				<Markdown class="about-original">
					<Content />
				</Markdown>
				<nav class="profile-sheet__links" aria-label="TumoTumoの外部リンク">
					{profileConfig.links.map((link) => (
						<a href={link.url} target="_blank" rel="me noopener">{link.name} ↗</a>
					))}
				</nav>
			</div>
		</section>

		<section class="about-principles" aria-labelledby="principles-heading">
			<header>
				<h2 id="principles-heading">ブログに<br />書くこと</h2>
			</header>
			<div class="about-principles__list">
				<article>
					<span>01</span>
					<h3>実際に使った感想</h3>
					<p>PCやスマホ、バイク用品を使ってみて、便利だったところや気になったところを書きます。</p>
				</article>
				<article>
					<span>02</span>
					<h3>個人開発の過程</h3>
					<p>Flutterを選んだ理由、審査で困ったこと、公開後に直したこと。アプリを作る中で経験したことを残しています。</p>
				</article>
			</div>
		</section>

		<section class="about-cta" aria-labelledby="about-cta-heading">
			<h2 id="about-cta-heading">最近の記事</h2>
			<a href={url("/#journal")}>ブログを読む <span aria-hidden="true">↘</span></a>
		</section>
	</main>
</EditorialLayout>
