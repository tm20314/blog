---
import EditorialLayout from "@layouts/EditorialLayout.astro";
---

<EditorialLayout
	title="記事プレビュー"
	description="microCMSで編集中の記事を確認するための非公開プレビューページです。"
	noindex
	robots="noindex, nofollow, noarchive"
	analytics={false}
>
	<meta slot="head" name="referrer" content="no-referrer" />

	<main id="main-content" class="content-page article-page preview-page">
		<div class="preview-banner" role="status">
			<span>PREVIEW</span>
			<p>これは編集中の記事です。一般公開ページには反映されていません。</p>
		</div>

		<p class="preview-status" data-preview-status aria-live="polite">
			記事プレビューを読み込んでいます…
		</p>

		<article class="article-document" data-preview-root hidden>
			<header class="article-header">
				<nav class="breadcrumb" aria-label="パンくずリスト">
					<a href="/archive/">記事一覧</a>
					<span aria-hidden="true">/</span>
					<span data-preview-category>未分類</span>
				</nav>
				<h1 data-preview-title>記事タイトル</h1>
				<p class="article-header__description" data-preview-description></p>
				<div class="article-facts" data-preview-facts aria-label="記事情報"></div>
				<nav class="article-tags" data-preview-tags aria-label="記事タグ"></nav>
			</header>

			<figure class="article-cover preview-cover">
				<img data-preview-cover src="/images/default-thumbnail.png" alt="" />
			</figure>

			<div class="article-layout preview-layout">
				<div class="article-reading">
					<div class="custom-md editorial-prose structured-article" data-preview-body></div>
				</div>
			</div>
		</article>
	</main>

	<script>
		import { initMicroCMSPreview } from "../scripts/microcms-preview";
		void initMicroCMSPreview();
	</script>
</EditorialLayout>

<style is:global>
	.preview-page {
		min-height: 70vh;
	}

	.preview-banner {
		display: flex;
		width: min(100% - (var(--page-gutter) * 2), var(--document-wide));
		margin: var(--space-lg) auto 0;
		align-items: center;
		gap: var(--space-md);
		padding: var(--space-sm) var(--space-md);
		border: var(--rule-strong) solid var(--color-ink);
		background: var(--color-accent);
		color: var(--color-accent-ink);
	}

	.preview-banner span,
	.preview-only-label {
		font-family: var(--font-mono);
		font-size: var(--text-xs);
		font-weight: 800;
		letter-spacing: 0.08em;
	}

	.preview-banner p {
		margin: 0;
		font-size: var(--text-sm);
		font-weight: 700;
	}

	.preview-status {
		width: min(100% - (var(--page-gutter) * 2), var(--document-reading));
		margin: var(--space-3xl) auto;
		padding: var(--space-xl);
		border: var(--rule-hair) solid var(--color-rule);
		background: var(--color-paper-2);
		text-align: center;
	}

	.preview-status[data-state="error"] {
		border-inline-start: var(--space-xs) solid var(--color-accent-ink);
		text-align: start;
	}

	.preview-cover {
		display: block;
		overflow: hidden;
	}

	.preview-layout {
		display: block;
		width: min(100%, var(--document-reading));
	}

	.preview-empty {
		padding: var(--space-xl);
		background: var(--color-paper-2);
		color: var(--color-muted);
	}

	@media (max-width: 42rem) {
		.preview-banner {
			align-items: flex-start;
			flex-direction: column;
		}
	}
</style>
