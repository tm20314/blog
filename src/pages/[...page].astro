---
import type { GetStaticPaths } from "astro";
import { Image } from "astro:assets";
import ArticleCard from "@components/editorial/ArticleCard.astro";
import avatarImage from "@assets/images/demo-avatar.jpg";
import bannerImage from "@assets/images/demo-banner.jpg";
import { projects } from "@/data/projects";
import EditorialLayout from "@layouts/EditorialLayout.astro";
import { PAGE_SIZE } from "../constants/constants";
import { getSortedPosts, getTagList } from "../utils/content-utils";
import { getPostUrlBySlug, getTagUrl, url } from "../utils/url-utils";

export const getStaticPaths = (async ({ paginate }) => {
	const allBlogPosts = await getSortedPosts();
	return paginate(allBlogPosts, { pageSize: PAGE_SIZE });
}) satisfies GetStaticPaths;
// https://github.com/withastro/astro/issues/6507#issuecomment-1489916992

const { page } = Astro.props;
const allPosts = await getSortedPosts();
const tags = (await getTagList()).sort((a, b) => b.count - a.count).slice(0, 8);
const isFirstPage = page.currentPage === 1;
const featuredPost =
	allPosts.find(
		(post) => post.slug === "tech-stack-of-easy-credit-search-app",
	) ?? allPosts[0];
const visiblePosts = page.data.filter(
	(post) => post.slug !== featuredPost.slug,
);
const homeUrl = url("/");
---

<EditorialLayout
	title={isFirstPage ? undefined : `記事一覧 ${page.currentPage}ページ`}
	noindex={!isFirstPage}
>
	<main id="main-content">
		<header class="opening-brief">
			<p class="opening-brief__label">Gadget journal / Independent development</p>
			<h1>使ったものと、<br />作ったものの記録。</h1>
			<div class="opening-brief__body">
				<p class="opening-brief__copy">
					PCやスマホ、バイクまわりの道具を実際に試す。欲しいものがなければ、アプリを作る。
					ここは、その過程と結果を率直に残す個人メディアです。
				</p>
				<a class="text-link" href="#journal">新着記事を読む <span aria-hidden="true">↓</span></a>
			</div>
		</header>

		{isFirstPage && featuredPost && (
			<section class="lead-layout" aria-labelledby="featured-heading">
				<article class="lead-story">
					<figure class="lead-story__media">
						<Image
							src={bannerImage}
							alt="海辺に停めたバイク"
							widths={[640, 960, 1280]}
							sizes="(min-width: 768px) 62vw, 100vw"
							format="avif"
							loading="eager"
							fetchpriority="high"
						/>
						<figcaption>Field note / Motorcycles and mobile tools</figcaption>
					</figure>
					<p class="story-kicker">Editor’s pick · 個人開発</p>
					<h2 id="featured-heading">
						<a href={getPostUrlBySlug(featuredPost.slug)}>{featuredPost.data.title}</a>
					</h2>
					<p class="lead-story__dek">
						プログラミング未経験から、学生向けアプリを企画・開発・公開するまで。技術選定と運用で得たことをまとめました。
					</p>
					<a class="text-link" href={getPostUrlBySlug(featuredPost.slug)}>記事を読む <span aria-hidden="true">→</span></a>
				</article>

				<aside class="issue-notes" aria-label="今号の案内">
					<div class="issue-note">
						<strong>Gadgets</strong>
						<span>PC / Mobile</span>
					</div>
					<div class="issue-note">
						<strong>Build notes</strong>
						<span>Flutter / iOS</span>
					</div>
					<div class="issue-note">
						<strong>Field notes</strong>
						<span>Bike / Daily life</span>
					</div>
					<a class="text-link" href={url("/archive/")}>すべての記事を見る <span aria-hidden="true">→</span></a>
				</aside>
			</section>
		)}

		<section class="section-frame" id="journal" aria-labelledby="journal-heading">
			<header class="section-heading">
				<span class="section-heading__index">01</span>
				<h2 id="journal-heading">{isFirstPage ? "新着記事" : `記事一覧 · ${page.currentPage}`}</h2>
				<p class="section-heading__aside">試したこと、直したこと、作ったもの。</p>
			</header>
			<div class="article-index">
				{visiblePosts.map((post, index) => (
					<ArticleCard post={post} index={(page.currentPage - 1) * PAGE_SIZE + index + 1} />
				))}
			</div>
		</section>

		{isFirstPage && (
			<section class="section-frame" aria-labelledby="topics-heading">
				<header class="section-heading">
					<span class="section-heading__index">02</span>
					<h2 id="topics-heading">テーマから探す</h2>
					<p class="section-heading__aside">興味の入口から、過去の記録へ。</p>
				</header>
				<div class="topic-index">
					{tags.map((tag) => (
						<a href={getTagUrl(tag.name)}>
							<span>{tag.name}</span>
							<span class="topic-index__count">{String(tag.count).padStart(2, "0")}</span>
						</a>
					))}
				</div>
			</section>
		)}

		{isFirstPage && (
			<section class="section-frame" id="works" aria-labelledby="works-heading">
				<header class="section-heading">
					<span class="section-heading__index">03</span>
					<h2 id="works-heading">つくったもの</h2>
					<p class="section-heading__aside">困りごとを、自分の手でプロダクトに。</p>
				</header>
				<div class="projects-grid">
					{projects.map((project) => (
						<article class="project">
							<p class="project__kicker">{project.kicker}</p>
							<h3><a href={url(project.href)}>{project.name}</a></h3>
							<p class="project__description">{project.description}</p>
							<p class="project__proof">{project.proof}</p>
							<ul class="project__stack" aria-label="使用技術・領域">
								{project.stack.map((item) => <li>{item}</li>)}
							</ul>
							<a class="project__link" href={url(project.href)}>{project.linkLabel} <span aria-hidden="true">→</span></a>
						</article>
					))}
				</div>
			</section>
		)}

		{isFirstPage && (
			<section class="author-strip" aria-labelledby="author-heading">
				<Image class="author-strip__portrait" src={avatarImage} alt="TumoTumoのプロフィール画像" width={192} height={192} />
				<div>
					<p class="story-kicker">About the developer</p>
					<h2 id="author-heading">TumoTumo</h2>
					<p>モバイルアプリを中心に個人開発するエンジニア。PC、スマホ、バイクなど、生活と開発を少し良くする道具が好きです。</p>
					<a class="text-link" href={url("/about/")}>プロフィールを見る <span aria-hidden="true">→</span></a>
				</div>
			</section>
		)}

		{page.lastPage > 1 && (
			<nav class="pagination" aria-label="記事一覧のページ送り">
				{page.url.prev ? <a href={page.url.prev}>← 前のページ</a> : <span aria-hidden="true" />}
				<span class="pagination__status">{page.currentPage} / {page.lastPage}</span>
				{page.url.next ? <a href={page.url.next}>次のページ →</a> : <a href={homeUrl}>最初に戻る</a>}
			</nav>
		)}
	</main>
</EditorialLayout>
