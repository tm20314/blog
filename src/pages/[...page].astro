---
import { Image } from "astro:assets";
import bannerImage from "@assets/images/demo-banner.jpg";
import avatarImage from "@assets/images/tumotumo-profile.jpg";
import ArticleCard from "@components/editorial/ArticleCard.astro";
import ProjectCard from "@components/editorial/ProjectCard.astro";
import AdSlot from "@components/integrations/AdSlot.astro";
import EditorialLayout from "@layouts/EditorialLayout.astro";
import type { GetStaticPaths } from "astro";
import { publication } from "@/config/site";
import { projects } from "@/data/projects";
import { PAGE_SIZE } from "../constants/constants";
import { getSortedPosts, getTagList } from "../utils/content-utils";
import { getPostUrlBySlug, getTagUrl, url } from "../utils/url-utils";

export const getStaticPaths = (async ({ paginate }) => {
	const allBlogPosts = await getSortedPosts();
	return paginate(allBlogPosts, { pageSize: PAGE_SIZE });
}) satisfies GetStaticPaths;
// https://github.com/withastro/astro/issues/6507#issuecomment-1489916992

const { page } = Astro.props;
const allPosts = await getSortedPosts();
const tags = (await getTagList()).sort((a, b) => b.count - a.count).slice(0, 8);
const isFirstPage = page.currentPage === 1;
const featuredPost =
	allPosts.find(
		(post) => post.slug === "tech-stack-of-easy-credit-search-app",
	) ?? allPosts[0];
const visiblePosts = page.data.filter(
	(post) => !isFirstPage || post.slug !== featuredPost?.slug,
);
const homeUrl = url("/");
---

<EditorialLayout
	title={isFirstPage ? undefined : `記事一覧 ${page.currentPage}ページ`}
	noindex={!isFirstPage}
>
	<main id="main-content">
		{isFirstPage && featuredPost && (
			<>
				<figure class="photo-hero">
					<div class="photo-hero__media">
						<Image
							src={bannerImage}
							alt="海辺に停めたバイク"
							widths={[640, 960, 1280, 1600]}
							sizes="(min-width: 1536px) 1472px, 100vw"
							format="avif"
							loading="eager"
							fetchpriority="high"
						/>
					</div>
					<figcaption class="photo-hero__caption">
						<span>Gadgets · Apps · Field notes</span>
						<strong>ガジェットと、作ったアプリの記録。</strong>
					</figcaption>
				</figure>

				<section class="intro-band" aria-labelledby="intro-heading">
					<div class="intro-band__title">
						<h1 id="intro-heading">ガジェット好きの<br />個人開発ブログ。</h1>
					</div>
					<div class="intro-band__copy">
						<p>PCやスマホ、バイクが好きなTumoTumoのブログです。使ってみた感想や、アプリ開発でつまずいたことを書いています。</p>
						<a class="text-link" href="#journal">新着記事へ <span aria-hidden="true">↓</span></a>
					</div>
				</section>

				<article class="featured-story" aria-labelledby="featured-heading">
					<div class="featured-story__meta">
						<span>Featured story</span>
						<span>個人開発</span>
					</div>
					<div class="featured-story__body">
						<h2 id="featured-heading"><a href={getPostUrlBySlug(featuredPost.slug)}>{featuredPost.data.title}</a></h2>
						<p>プログラミング未経験から、学生向けアプリを企画・開発・公開するまで。技術選定と運用で得たことをまとめました。</p>
						<a class="text-link text-link--accent" href={getPostUrlBySlug(featuredPost.slug)}>この記事を読む <span aria-hidden="true">↗</span></a>
					</div>
				</article>
			</>
		)}

		<section class:list={["journal", !isFirstPage && "journal--archive"]} id="journal" aria-labelledby="journal-heading">
			<header class="section-heading section-heading--journal">
				<div>
					{isFirstPage
						? <h2 id="journal-heading">新着記事</h2>
						: <h1 id="journal-heading">記事一覧</h1>}
					<p>{isFirstPage ? "最近書いた記事はこちら。" : `${page.currentPage}ページ目`}</p>
				</div>
				<a class="text-link" href={url("/archive/")}>すべて見る <span aria-hidden="true">→</span></a>
			</header>
			<div class="article-index">
				{visiblePosts.slice(0, 2).map((post, index) => (
					<ArticleCard post={post} variant={index === 0 ? "lead" : "standard"} />
				))}
				{visiblePosts.length > 2 && (
					<AdSlot
						slot={publication.ads.feed.slot}
						placement="feed"
						format="fluid"
						layoutKey={publication.ads.feed.layoutKey}
					/>
				)}
				{visiblePosts.slice(2).map((post) => (
					<ArticleCard post={post} variant="standard" />
				))}
			</div>
		</section>

		{isFirstPage && (
			<section class="topic-strip" aria-labelledby="topics-heading">
				<h2 id="topics-heading">気になるテーマから</h2>
				<div class="topic-index">
					{tags.map((tag) => (
						<a href={getTagUrl(tag.name)}>
							<span>{tag.name}</span>
							<span class="topic-index__count">{tag.count}</span>
						</a>
					))}
				</div>
			</section>
		)}

		{isFirstPage && (
			<section class="works" id="works" aria-labelledby="works-heading">
				<header class="works__heading">
					<h2 id="works-heading">つくったアプリ</h2>
					<p>大学の情報を調べたり、近くのお店を探したり。自分で作って公開しているアプリです。気になったものはストアで見てみてください。</p>
					<dl class="works__summary" aria-label="作品一覧の概要">
						<div>
							<dt>Released</dt>
							<dd>{projects.length} apps</dd>
						</div>
						<div>
							<dt>Platforms</dt>
							<dd>iOS / Android</dd>
						</div>
					</dl>
				</header>
				<div class="projects-grid">
					{projects.map((project, index) => (
						<ProjectCard project={project} index={index} total={projects.length} />
					))}
				</div>
			</section>
		)}

		{isFirstPage && (
			<section class="author-panel" aria-labelledby="author-heading">
				<Image
					class="author-panel__portrait"
					src={avatarImage}
					alt="屋外で微笑むTumoTumoのポートレート"
					widths={[320, 480, 640]}
					sizes="(min-width: 48rem) 40vw, 100vw"
					format="avif"
					loading="lazy"
				/>
				<div class="author-panel__body">
					<p class="author-panel__role">Developer / Writer</p>
					<h2 id="author-heading">TumoTumo</h2>
					<p>PCやスマホ、バイクが好きなエンジニアです。岡理アプリなどのモバイルアプリを個人で開発しています。</p>
					<a class="text-link" href={url("/about/")}>プロフィール <span aria-hidden="true">↗</span></a>
				</div>
			</section>
		)}

		{!isFirstPage && page.lastPage > 1 && (
			<nav class="pagination" aria-label="記事一覧のページ送り">
				{page.url.prev ? <a href={page.url.prev}>← 前のページ</a> : <span aria-hidden="true" />}
				<span class="pagination__status">{page.currentPage} / {page.lastPage}</span>
				{page.url.next ? <a href={page.url.next}>次のページ →</a> : <a href={homeUrl}>最初に戻る</a>}
			</nav>
		)}
	</main>
</EditorialLayout>
