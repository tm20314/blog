---
import path from "node:path";
import Markdown from "@components/misc/Markdown.astro";
import I18nKey from "@i18n/i18nKey";
import { i18n } from "@i18n/translation";
import EditorialLayout from "@layouts/EditorialLayout.astro";
import { getSortedPosts } from "@utils/content-utils";
import {
	getCategoryUrl,
	getDir,
	getPostUrlBySlug,
	getTagUrl,
	url,
} from "@utils/url-utils";
import "katex/dist/katex.css";
import { licenseConfig, profileConfig, siteConfig } from "@/config";
import ImageWrapper from "../../components/misc/ImageWrapper.astro";
import { formatDateToYYYYMMDD } from "../../utils/date-utils";

export async function getStaticPaths() {
	const blogEntries = await getSortedPosts();
	return blogEntries.map((entry) => ({
		params: { slug: entry.slug },
		props: { entry },
	}));
}

const { entry } = Astro.props;
const { Content, headings, remarkPluginFrontmatter } = await entry.render();
const language = entry.data.lang || siteConfig.lang;
const description = entry.data.description || entry.data.title;
const category = entry.data.category?.trim() || i18n(I18nKey.uncategorized);
const canonicalUrl = new URL(
	getPostUrlBySlug(entry.slug),
	Astro.site ?? Astro.url.origin,
).toString();
const headingDepths = headings.map((heading) => heading.depth);
const firstHeadingDepth =
	headingDepths.length > 0 ? Math.min(...headingDepths) : 1;
const tocHeadings = headings.filter(
	(heading) => heading.depth < firstHeadingDepth + siteConfig.toc.depth,
);

const jsonLd = {
	"@context": "https://schema.org",
	"@type": "BlogPosting",
	"@id": `${canonicalUrl}#article`,
	mainEntityOfPage: canonicalUrl,
	headline: entry.data.title,
	description,
	keywords: entry.data.tags,
	author: {
		"@type": "Person",
		name: profileConfig.name,
		url: new URL(url("/about/"), Astro.site ?? Astro.url.origin).toString(),
	},
	publisher: {
		"@type": "Person",
		name: profileConfig.name,
	},
	datePublished: entry.data.published.toISOString(),
	...(entry.data.updated
		? { dateModified: entry.data.updated.toISOString() }
		: {}),
	inLanguage: language.replace("_", "-"),
};
---

<EditorialLayout
	title={entry.data.title}
	description={description}
	lang={language}
	ogType="article"
	publishedTime={entry.data.published}
	modifiedTime={entry.data.updated}
	tags={entry.data.tags}
>
	<script is:inline slot="head" type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

	<main id="main-content" class="content-page article-page">
		<article class="article-document">
			<header class="article-header">
				<nav class="breadcrumb" aria-label="パンくずリスト">
					<a href={url("/archive/")}>記事一覧</a>
					<span aria-hidden="true">/</span>
					<a href={getCategoryUrl(entry.data.category)}>{category}</a>
				</nav>
				<h1 data-pagefind-body data-pagefind-weight="10" data-pagefind-meta="title">
					{entry.data.title}
				</h1>
				{entry.data.description && <p class="article-header__description">{entry.data.description}</p>}
				<div class="article-facts" aria-label="記事情報">
					<time datetime={entry.data.published.toISOString()}>
						公開 {formatDateToYYYYMMDD(entry.data.published).replaceAll("-", ".")}
					</time>
					{entry.data.updated && (
						<time datetime={entry.data.updated.toISOString()}>
							更新 {formatDateToYYYYMMDD(entry.data.updated).replaceAll("-", ".")}
						</time>
					)}
					<span>{remarkPluginFrontmatter.words ?? 0}文字</span>
					<span>{remarkPluginFrontmatter.minutes ?? 0}分</span>
				</div>
				{entry.data.tags.length > 0 && (
					<nav class="article-tags" aria-label="記事タグ">
						{entry.data.tags.map((tag) => <a href={getTagUrl(tag)}>#{tag}</a>)}
					</nav>
				)}
			</header>

			{entry.data.image && (
				<ImageWrapper
					id="post-cover"
					src={entry.data.image}
					basePath={path.join("content/posts/", getDir(entry.id))}
					class="article-cover"
					alt=""
				/>
			)}

			<div class="article-layout">
				<div class="article-reading">
					<Markdown class="editorial-prose">
						<Content />
					</Markdown>

					{licenseConfig.enable && (
						<aside class="article-license" aria-labelledby="license-heading">
							<h2 id="license-heading">この記事について</h2>
							<p>{entry.data.title}</p>
							<dl>
								<div>
									<dt>作者</dt>
									<dd>{profileConfig.name}</dd>
								</div>
								<div>
									<dt>公開日</dt>
									<dd>{formatDateToYYYYMMDD(entry.data.published)}</dd>
								</div>
								<div>
									<dt>ライセンス</dt>
									<dd><a href={licenseConfig.url} target="_blank" rel="license noopener">{licenseConfig.name}</a></dd>
								</div>
							</dl>
							<a class="article-license__url" href={canonicalUrl}>{canonicalUrl}</a>
						</aside>
					)}
				</div>

				{siteConfig.toc.enable && tocHeadings.length > 0 && (
					<aside class="article-toc" aria-labelledby="toc-heading">
						<h2 id="toc-heading">目次</h2>
						<nav aria-label="記事の目次">
							<ol>
								{tocHeadings.map((heading) => (
									<li class:list={[heading.depth > firstHeadingDepth && "article-toc__nested"]}>
										<a href={`#${heading.slug}`}>{heading.text}</a>
									</li>
								))}
							</ol>
						</nav>
					</aside>
				)}
			</div>
		</article>

		{(entry.data.nextSlug || entry.data.prevSlug) && (
			<nav class="article-pagination" aria-label="前後の記事">
				{entry.data.nextSlug ? (
					<div class="article-pagination__item">
						<p>{entry.data.nextTitle}</p>
						<a href={getPostUrlBySlug(entry.data.nextSlug)}>← 新しい記事</a>
					</div>
				) : <span aria-hidden="true" />}
				{entry.data.prevSlug ? (
					<div class="article-pagination__item article-pagination__item--next">
						<p>{entry.data.prevTitle}</p>
						<a href={getPostUrlBySlug(entry.data.prevSlug)}>過去の記事 →</a>
					</div>
				) : <span aria-hidden="true" />}
			</nav>
		)}
	</main>
</EditorialLayout>
