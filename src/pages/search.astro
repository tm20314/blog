---
import EditorialLayout from "@layouts/EditorialLayout.astro";
---
<EditorialLayout title="サイト内検索" description="つもログの記事をキーワードで検索できます。" noindex>
	<main id="main-content" class="content-page search-page">
		<header class="page-intro"><div class="page-intro__title"><p class="page-intro__index">Search</p><h1>記事を検索する</h1></div><p>タイトルや本文から、気になる記事を探せます。</p></header>
		<form class="site-search" action="/search/" method="get" role="search">
			<label for="search-query">キーワード</label>
			<div class="site-search__controls"><input id="search-query" name="q" type="search" autocomplete="off" maxlength="200" placeholder="例：Flutter、iPhone" /><button type="submit">検索</button></div>
		</form>
		<p data-search-status role="status">キーワードを入力して検索してください。</p>
		<ol class="search-results" data-search-results></ol>
		<noscript><p>検索にはJavaScriptが必要です。<a href="/archive/">記事一覧</a>からも探せます。</p></noscript>
	</main>
</EditorialLayout>
<script is:inline>
	// Native import: Pagefind is generated after Astro and must not be bundled.
	window.tumoLoadSearch = () => import("/pagefind/pagefind.js");
</script>
<script>
	import { initSiteSearch } from "@/scripts/site-search";
	initSiteSearch();
</script>
