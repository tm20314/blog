{
	"name": "blog",
	"type": "module",
	"version": "0.0.1",
	"engines": { "node": ">=22.12.0" },
	"scripts": {
		"dev": "astro dev",
		"start": "astro dev",
		"check": "astro check",
		"build": "astro build && pagefind --site dist",
		"preview": "astro preview",
		"astro": "astro",
		"type-check": "tsc --noEmit --isolatedDeclarations",
		"test:embeds": "node --test tests/rehype-smart-embeds.test.mjs",
		"test:blocks": "node --test tests/rehype-editorial-blocks.test.mjs",
		"test:related": "node --import tsx --test tests/related-posts.test.ts",
		"test:domain": "node --test tests/domain-redirect.test.mjs",
		"test:microcms": "node --import tsx --test tests/microcms-normalize.test.ts",
		"test:site": "node --import tsx --test tests/*.test.ts tests/*.test.mjs",
		"test:build": "node scripts/verify-build.mjs",
		"test:public": "node scripts/verify-public.mjs",
		"test:preview": "node --test tests/microcms-preview-function.test.mjs",
		"test:cms-embeds": "node --import tsx --test tests/embed-utils.test.ts",
		"test:cms-rich-text": "node --import tsx --test tests/cms-rich-text.test.ts",
		"new-post": "node scripts/new-post.js",
		"format": "biome format --write ./src",
		"lint": "biome check --write ./src",
		"preinstall": "npx only-allow pnpm"
	},
	"dependencies": {
		"@astrojs/check": "^0.9.10",
		"@astrojs/markdown-remark": "7.3.0",
		"@astrojs/rss": "^4.0.19",
		"@astrojs/svelte": "9.0.1",
		"@expressive-code/core": "^0.44.2",
		"@expressive-code/plugin-collapsible-sections": "^0.44.2",
		"@expressive-code/plugin-line-numbers": "^0.44.2",
		"@fontsource-variable/bricolage-grotesque": "5.3.0",
		"@fontsource-variable/jetbrains-mono": "^5.3.0",
		"@fontsource-variable/noto-sans-jp": "5.3.0",
		"@fontsource/roboto": "^5.3.0",
		"@iconify-json/fa6-brands": "^1.2.6",
		"@iconify-json/fa6-regular": "^1.2.4",
		"@iconify-json/fa6-solid": "^1.2.4",
		"@iconify-json/material-symbols": "^1.2.93",
		"@iconify/svelte": "^4.2.0",
		"@tailwindcss/typography": "^0.5.20",
		"@tiptap/core": "^3.31.4",
		"@tiptap/extension-image": "^3.31.4",
		"@tiptap/extension-table": "^3.31.4",
		"@tiptap/pm": "^3.31.4",
		"@tiptap/starter-kit": "^3.31.4",
		"astro": "7.3.5",
		"astro-expressive-code": "^0.44.2",
		"astro-icon": "^1.2.0",
		"hastscript": "^9.0.1",
		"htmlparser2": "^12.0.0",
		"katex": "^0.16.47",
		"markdown-it": "^14.3.2",
		"mdast-util-to-string": "^4.0.0",
		"overlayscrollbars": "^2.16.0",
		"pagefind": "^1.5.2",
		"photoswipe": "^5.4.4",
		"reading-time": "^1.5.0",
		"rehype-autolink-headings": "^7.1.0",
		"rehype-components": "^0.3.0",
		"rehype-katex": "^7.0.1",
		"rehype-slug": "^6.0.0",
		"remark-directive": "^3.0.1",
		"remark-directive-rehype": "^0.4.2",
		"remark-github-admonitions-to-directives": "^1.0.5",
		"remark-math": "^6.0.0",
		"remark-sectionize": "^2.1.0",
		"sanitize-html": "^2.17.7",
		"sharp": "^0.35.4",
		"stylus": "^0.64.0",
		"svelte": "^5.57.1",
		"tailwindcss": "^3.4.19",
		"typescript": "^5.9.3",
		"unist-util-visit": "^5.1.0"
	},
	"devDependencies": {
		"@astrojs/ts-plugin": "^1.10.12",
		"@biomejs/biome": "2.2.5",
		"@rollup/plugin-yaml": "^4.1.2",
		"@types/hast": "^3.0.5",
		"@types/markdown-it": "^14.2.0",
		"@types/mdast": "^4.0.4",
		"@types/sanitize-html": "^2.16.2",
		"jsdom": "^30.1.1",
		"postcss-import": "^16.2.0",
		"postcss-nesting": "^13.0.2",
		"tsx": "^4.23.15"
	},
	"packageManager": "pnpm@9.14.4"
}
